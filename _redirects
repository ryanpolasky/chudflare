# Chudflare _redirects: Cloudflare Pages format
# Drop this file at the root of your deploy alongside _headers.
#
# Cloudflare Pages automatically serves /foo from foo.html, so we do NOT
# need 200 rewrites for that. The only rules we need are:
#   1. 301 redirects from /foo.html -> /foo (canonicalize the URL)
#   2. 301 alias for /psl -> /psl-detector (custom shortlink)
#
# IMPORTANT: do not add 200 rewrites pointing back to .html files here.
# Cloudflare's static asset handling will combine with the 301 below to
# produce an infinite redirect loop (ERR_TOO_MANY_REDIRECTS).

# canonical: strip .html from any URL someone types directly
/index.html              /              301
/products.html           /products      301
/pricing.html            /pricing       301
/chud-check.html         /chud-check    301
/chudify.html            /chudify       301
/psl-detector.html       /psl-detector  301
/status.html             /status        301
/verify.html             /verify        301
/apply.html              /apply         301
/blog/index.html         /blog          301
/1020.html               /1020          301

# shortlink alias
/psl                     /psl-detector  301
